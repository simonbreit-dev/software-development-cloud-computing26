# Compose
COMPOSE_PROJECT_NAME=sdfcc

# Backend image/build
BACKEND_IMAGE=sdfcc-backend:local
BACKEND_HTTP_BIND=127.0.0.1:8080
MAVEN_BUILD_ARGS=-DskipTests
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Backend application
SPRING_APPLICATION_NAME=sdfcc-backend
DEPLOYMENT_ENVIRONMENT=local

# Database used by the backend container
DATABASE_URL=jdbc:postgresql://postgres:5432/sdfcc
DATABASE_USERNAME=sdfcc
DATABASE_PASSWORD=sdfcc
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Local PostgreSQL service
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=sdfcc
POSTGRES_USER=sdfcc
POSTGRES_PASSWORD=sdfcc
POSTGRES_BIND=127.0.0.1:5432

# JWT Settings
#JWT_ISSUER=sdfcc
#JWT_SIGNING_KEY=
#JWT_EXPIRATION_HOURS=2

# OpenTelemetry app-native export to the existing observability stack
OTEL_SERVICE_NAME=sdfcc-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=sdfcc,deployment.environment=local
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000

# Existing observability stack
OBSERVABILITY_NETWORK=observability_observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HTTP_BIND=127.0.0.1:3000
ALLOY_UI_BIND=127.0.0.1:12345
ALLOY_OTLP_GRPC_BIND=4317
ALLOY_OTLP_HTTP_BIND=4318
PROMETHEUS_IMAGE=prom/prometheus:v3
LOKI_IMAGE=grafana/loki:3.7.0
TEMPO_IMAGE=grafana/tempo:2.10.3
ALLOY_IMAGE=grafana/alloy:latest
GRAFANA_IMAGE=grafana/grafana:12.4.2
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000/
